# GEMINI_API_KEY: Required for AquaSense AI LLM insights via server-side @google/genai.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Python FastAPI scikit-learn service URL (when running backend/main.py separately on port 8000)
FASTAPI_BACKEND_URL="http://127.0.0.1:8000"

# Optional PostgreSQL connection string for external persistence
DATABASE_URL="postgresql://postgres:password@localhost:5432/pondhealth_ai"

# Optional MQTT Broker URL for physical aquaculture telemetry probes
MQTT_BROKER_URL="mqtt://broker.hivemq.com:1883"
